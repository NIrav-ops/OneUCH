map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream oneuch_asgi {
    server 127.0.0.1:8000;
    keepalive 32;
}


server {
    listen 80;
    server_name api.oneuch.example;

    return 301 https://$host$request_uri;
}


server {
    listen 443 ssl;
    server_name api.oneuch.example;

    ssl_certificate
        /etc/letsencrypt/live/api.oneuch.example/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/api.oneuch.example/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 25m;


    # Django static assets collected by:
    #
    #     python manage.py collectstatic --noinput
    #
    location /static/ {
        alias /opt/oneuch/backend/staticfiles/;
    }


    location /media/ {
        alias /opt/oneuch/backend/media/;
    }


    # WebSocket / Channels traffic
    location /ws/ {
        proxy_pass http://oneuch_asgi;

        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Required by MVP-07.4C WebSocket JWT transport.
        proxy_set_header Sec-WebSocket-Protocol
            $http_sec_websocket_protocol;

        proxy_set_header Host $host;

        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For
            $proxy_add_x_forwarded_for;

        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }


    # Django HTTP/API traffic
    location / {
        proxy_pass http://oneuch_asgi;

        proxy_http_version 1.1;

        proxy_set_header Host $host;

        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For
            $proxy_add_x_forwarded_for;

        proxy_connect_timeout 30;
        proxy_read_timeout 120;
        proxy_send_timeout 120;
    }
}
