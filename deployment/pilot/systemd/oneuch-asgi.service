[Unit]
Description=One UCH Daphne ASGI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oneuch
Group=oneuch

WorkingDirectory=/opt/oneuch/backend

EnvironmentFile=/opt/oneuch/backend/.env
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/opt/oneuch/backend/venv/bin/python manage.py validate_pilot_environment

ExecStart=/opt/oneuch/backend/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8000 \
    backend.asgi:application

Restart=on-failure
RestartSec=5

TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
