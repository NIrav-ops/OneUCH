[Unit]
Description=One UCH Celery Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oneuch
Group=oneuch

WorkingDirectory=/opt/oneuch/backend

EnvironmentFile=/opt/oneuch/backend/.env
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/opt/oneuch/backend/venv/bin/python manage.py validate_pilot_environment

ExecStart=/opt/oneuch/backend/venv/bin/celery \
    -A backend \
    worker \
    --loglevel=INFO \
    --pool=prefork \
    --concurrency=2

Restart=on-failure
RestartSec=5

TimeoutStopSec=60
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
