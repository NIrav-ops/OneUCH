# ==================================================
# One UCH - Environment Configuration Template
# ==================================================
#
# Copy this file to .env for LOCAL DEVELOPMENT only.
#
# Do NOT use these defaults for a pilot deployment.
# Pilot configuration starts from:
#
#     backend/.env.pilot.example
#
# NEVER place real production secrets in tracked templates.
# ==================================================


# --------------------------------------------------
# Django
# --------------------------------------------------

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost


# --------------------------------------------------
# Deployment Security
# --------------------------------------------------

DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false


# --------------------------------------------------
# CORS
# --------------------------------------------------

CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173


# --------------------------------------------------
# Database
#
# sqlite = local development default
# postgresql = pilot / production
# --------------------------------------------------

DJANGO_DB_ENGINE=sqlite

DB_NAME=oneuch
DB_USER=oneuch
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60


# --------------------------------------------------
# Redis / Celery / Channels
# --------------------------------------------------

REDIS_URL=redis://127.0.0.1:6379/0

# Windows local development:
CELERY_WORKER_POOL=solo


# --------------------------------------------------
# Google OAuth
# --------------------------------------------------

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/oauth/callback/


# --------------------------------------------------
# Microsoft OAuth
# --------------------------------------------------

MICROSOFT_CLIENT_ID=replace-me
MICROSOFT_CLIENT_SECRET=replace-me
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/microsoft/oauth/callback/


# --------------------------------------------------
# API
# --------------------------------------------------

DRF_USER_THROTTLE_RATE=1000/hour
AUTH_SIGNUP_THROTTLE_RATE=10/hour
AUTH_LOGIN_THROTTLE_RATE=30/minute
AUTH_SELF_SERVICE_SIGNUP_ENABLED=false\nONEUCH_ENVIRONMENT=development\nONEUCH_REGION=local


# --------------------------------------------------
# Razorpay
# --------------------------------------------------

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me


# --------------------------------------------------
# Development seed utility
# --------------------------------------------------

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me

# One UCH AI
OPENAI_API_KEY=
ONEUCH_AI_PROVIDER=openai
ONEUCH_AI_MODE=cloud
ONEUCH_AI_MODEL=gpt-5.6-luna
ONEUCH_AI_TIMEOUT_SECONDS=30

# Local/private AI
ONEUCH_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Action Intelligence
ACTION_AI_ENABLED=false
ACTION_AI_AUTO_CREATE_THRESHOLD=90
ACTION_AI_REVIEW_THRESHOLD=75
ACTION_AI_ALLOWED_ACCOUNT_IDS=


APPROVAL_AI_ENABLED=
APPROVAL_AI_AUTO_CREATE_THRESHOLD=95
APPROVAL_AI_REVIEW_THRESHOLD=85
APPROVAL_AI_MAX_ATTEMPTS=3
APPROVAL_AI_RETRY_BASE_SECONDS=300
APPROVAL_AI_RETRY_MAX_SECONDS=3600
APPROVAL_AI_ALLOWED_ACCOUNT_IDS=