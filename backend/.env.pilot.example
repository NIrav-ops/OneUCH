# ==================================================
# One UCH - PILOT Environment Configuration Template
# ==================================================
#
# Copy this file to .env on the PILOT application host,
# then replace every placeholder with the real environment
# value through the deployment secret/configuration process.
#
# NEVER commit the resulting .env file.
#
# This template intentionally differs from .env.example.
# Local development defaults must not be promoted to pilot.
# ==================================================


# --------------------------------------------------
# Django
# --------------------------------------------------

DJANGO_SECRET_KEY=replace-with-a-long-random-pilot-secret
DJANGO_DEBUG=false

# Public backend hostname only.
# Never use "*" for a pilot.
DJANGO_ALLOWED_HOSTS=api.oneuch.example


# --------------------------------------------------
# HTTPS / transport security
# --------------------------------------------------

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Start conservatively after HTTPS is confirmed working.
# Increase after the pilot domain/HTTPS path is stable.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false


# --------------------------------------------------
# CORS
# --------------------------------------------------

CORS_ALLOW_ALL_ORIGINS=false

# Exact public frontend origin(s), comma separated.
CORS_ALLOWED_ORIGINS=https://app.oneuch.example


# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

DJANGO_DB_ENGINE=postgresql

DB_NAME=oneuch
DB_USER=oneuch
DB_PASSWORD=replace-with-database-password

# 127.0.0.1 is acceptable when PostgreSQL runs on the same
# protected host. Otherwise use the private DB hostname.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60


# --------------------------------------------------
# Redis / Celery / Channels
# --------------------------------------------------

# A loopback Redis endpoint is acceptable when Redis is on the
# same protected host. Otherwise use the private Redis endpoint.
REDIS_URL=redis://127.0.0.1:6379/0

# Linux pilot worker process.
CELERY_WORKER_POOL=prefork


# --------------------------------------------------
# Google OAuth
# --------------------------------------------------

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://api.oneuch.example/api/google/oauth/callback/


# --------------------------------------------------
# Microsoft OAuth
# --------------------------------------------------

MICROSOFT_CLIENT_ID=replace-me
MICROSOFT_CLIENT_SECRET=replace-me
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://api.oneuch.example/api/microsoft/oauth/callback/


# --------------------------------------------------
# API
# --------------------------------------------------

DRF_USER_THROTTLE_RATE=1000/hour
AUTH_SIGNUP_THROTTLE_RATE=10/hour
AUTH_LOGIN_THROTTLE_RATE=30/minute
AUTH_SELF_SERVICE_SIGNUP_ENABLED=false
ONEUCH_ENVIRONMENT=pilot
ONEUCH_REGION=replace-with-deployment-region


# --------------------------------------------------
# Razorpay
# --------------------------------------------------

RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me


# --------------------------------------------------
# One UCH AI
# --------------------------------------------------

OPENAI_API_KEY=

ONEUCH_AI_PROVIDER=openai
ONEUCH_AI_MODE=cloud
ONEUCH_AI_MODEL=gpt-5.6-luna
ONEUCH_AI_TIMEOUT_SECONDS=30

ONEUCH_OLLAMA_BASE_URL=http://127.0.0.1:11434

ACTION_AI_ENABLED=false
ACTION_AI_AUTO_CREATE_THRESHOLD=90
ACTION_AI_REVIEW_THRESHOLD=75
ACTION_AI_ALLOWED_ACCOUNT_IDS=

APPROVAL_AI_ENABLED=false
APPROVAL_AI_AUTO_CREATE_THRESHOLD=95
APPROVAL_AI_REVIEW_THRESHOLD=85
APPROVAL_AI_MAX_ATTEMPTS=3
APPROVAL_AI_RETRY_BASE_SECONDS=300
APPROVAL_AI_RETRY_MAX_SECONDS=3600
APPROVAL_AI_ALLOWED_ACCOUNT_IDS=
