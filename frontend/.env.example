# One UCH frontend runtime endpoints
#
# Local development can leave these empty. The frontend will
# use http://127.0.0.1:8000 and derive ws:// automatically.
#
# For a same-origin production deployment these can also remain
# empty and the production build uses window.location.origin.
#
# For a split frontend/backend deployment, set the real public
# endpoints at BUILD TIME because Vite embeds VITE_* variables
# into the frontend bundle.
#
# Example:
# VITE_API_BASE_URL=https://api.oneuch.example
# VITE_WS_BASE_URL=wss://api.oneuch.example

VITE_API_BASE_URL=
VITE_WS_BASE_URL=
